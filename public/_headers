# ─── Cloudflare Pages Headers ───
# Security + Cache optimization

# Security headers (all pages)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://img.bluehair.blue https://*.bluehair.blue data:; connect-src 'self' https://*.bluehair.blue; frame-ancestors 'none'

# HTML (SPA shell) — 항상 최신 확인, CDN에 짧게 캐시
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=60, s-maxage=300
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=60, s-maxage=300

# Hashed JS/CSS (Vite 빌드 출력, 파일명에 해시 포함) — 장기 캐시
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

# 정적 에셋 (favicon, icons) — 중기 캐시
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 폰트 (Google Fonts CDN에서 제공하므로 로컬 불필요, 만약 로컬 폰트 추가 시)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
